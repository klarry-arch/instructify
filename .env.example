# ============================================================
# INSTRUCTIFY KENYA — Environment Variables
# Copy to .env.local for local development via Vercel CLI.
# NEVER commit real credentials to version control.
# ============================================================

# ── Payment Provider ────────────────────────────────────────
# Provider: paystack
PAYMENT_PROVIDER=paystack

# Paystack API keys (get from https://dashboard.paystack.com/#/settings/developers)
# Use pk_test_ / sk_test_ for sandbox, pk_live_ / sk_live_ for production
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack webhook secret — set in Paystack Dashboard → Settings → Webhooks
# This is the secret used to verify HMAC-SHA512 webhook signatures
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Application ─────────────────────────────────────────────
# Full base URL of the deployed application (no trailing slash)
APP_BASE_URL=https://instructify.vercel.app

# Payment environment: sandbox | live
PAYMENT_ENVIRONMENT=sandbox

# ── Vercel KV (Redis) ───────────────────────────────────────
# Auto-injected by Vercel when a KV store is linked to the project.
# For local dev: run `vercel env pull .env.local` after linking.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Paystack Callback URLs ──────────────────────────────────
# These must be HTTPS. Register the webhook URL in your Paystack dashboard.
PAYSTACK_WEBHOOK_URL=https://instructify.vercel.app/api/webhook/paystack
PAYSTACK_CALLBACK_URL=https://instructify.vercel.app/payment-success.html

# ── Rate Limiting (optional — set low values to protect endpoints) ──
RATE_LIMIT_PAYMENT_RPM=10
RATE_LIMIT_WEBHOOK_RPM=100
