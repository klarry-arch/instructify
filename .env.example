# ============================================================
# INSTRUCTIFY KENYA — Environment Variables
# Copy to .env.local for local development.
# NEVER commit real credentials to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
# Full base URL of the deployed application (no trailing slash)
APP_BASE_URL=https://instructify.co.ke
PORT=8080

# Payment environment: sandbox | production | live
PAYMENT_ENVIRONMENT=sandbox

# ── Safaricom Daraja M-Pesa Express (STK Push) ───────────────
# Get credentials from Safaricom Developer Portal: https://developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_SHORTCODE=174379
MPESA_SHORTCODE_TYPE=CustomerPayBillOnline
MPESA_INITIATOR_NAME=
MPESA_CALLBACK_URL=https://instructify.co.ke/api/webhook/mpesa

# ── Paystack (Cards & International Payments) ────────────────
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_URL=https://instructify.co.ke/api/webhook/paystack
PAYSTACK_CALLBACK_URL=https://instructify.co.ke/payment-success.html

# ── Vercel KV / Redis (Data Store) ───────────────────────────
# Auto-injected in production. In local dev, falls back to memory store.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PAYMENT_RPM=10
RATE_LIMIT_WEBHOOK_RPM=100

# ── Official Business Email (SMTP / Mail Dispatch) ───────────
# HOSTAFRICA DirectAdmin Linux server (mail.instructify.co.ke / 102.210.146.106)
# If left blank, native PHP mail() / local sendmail binary is used on the server.
SMTP_HOST=mail.instructify.co.ke
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_AUTH=true

# Commercial & Advisory Desk Mailbox
SMTP_USER_INFO=info@instructify.co.ke
SMTP_PASS_INFO=your_info_mailbox_password_here

# Support & Technical Desk Mailbox
SMTP_USER_SUPPORT=support@instructify.co.ke
SMTP_PASS_SUPPORT=your_support_mailbox_password_here

# Fallback / Default Mailbox
SMTP_USER=info@instructify.co.ke
SMTP_PASS=your_info_mailbox_password_here
SMTP_FROM_NAME="Instructify Kenya"
